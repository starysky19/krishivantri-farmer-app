# SUPABASE_URL: Supabase project base URL
SUPABASE_URL=https://leawuzhjkuzwgzdduwzq.supabase.co

# SUPABASE_ANON_KEY: Supabase publishable or anon key (configure in AI Studio Secrets panel)
SUPABASE_ANON_KEY=MY_SUPABASE_ANON_KEY

# RAZORPAY_KEY_ID: Razorpay Checkout Key ID (configure in AI Studio Secrets panel; keep key_secret strictly on backend)
RAZORPAY_KEY_ID=MY_RAZORPAY_KEY_ID

# SATELLITE_TILE_URL: Separately licensed high-res satellite imagery WMTS/XYZ tile URL template
SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# SATELLITE_API_KEY: API key for separately licensed satellite imagery provider (configure in AI Studio Secrets)
SATELLITE_API_KEY=MY_SATELLITE_API_KEY
